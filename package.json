{
  "name": "zentask-pro-utility",
  "version": "1.4.0",
  "description": "ZenTask - macro recorder, auto-clicker, webhook notifier",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.test.zentaskpro",
    "productName": "ZenTask",
    "artifactName": "ZenTask.${ext}",
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "index.html",
      "icon.png"
    ],
    "asarUnpack": [
      "**/node_modules/uiohook-napi/**",
      "icon.png"
    ]
  }
}
